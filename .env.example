# Load order (lowest to highest priority): .env -> .env.deepseek -> .env.local -> .env.runtime
# Unified LLM config (P1.5). LLM_* wins; DEEPSEEK_* kept as compat fallback.
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=512
# LLM_API_KEY=sk-...            (keep the real key in .env.local only; never commit)

# Legacy fallback variables (used only when the unified LLM_* ones are unset).
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=3

# Runtime device profiles (P1). Precedence: CLI args > env vars > configs/runtime/<profile>.toml.
# Default profile is low_vram (embedding on CUDA, reranker on CPU).
#RUNTIME_PROFILE=low_vram
#EMBEDDING_DEVICE=cuda
#RERANKER_DEVICE=cpu
#EMBEDDING_BATCH_SIZE=4
#RERANKER_BATCH_SIZE=2

REMOTE_HOST=your.remote.host
REMOTE_PORT=22
REMOTE_USER=your_user
REMOTE_KEY_PATH=.ssh/your_key
